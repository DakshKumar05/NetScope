# Backend configuration. Copy to .env and edit as needed.
# Every variable is optional; the defaults shown are what the app uses.

# --- storage -----------------------------------------------------------
NES_DATABASE_URL=sqlite:///./network_scanner.db

# --- CORS --------------------------------------------------------------
NES_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- scanning defaults -------------------------------------------------
NES_DEFAULT_TIMEOUT=1.0
NES_DEFAULT_CONCURRENCY=100
NES_MAX_CONCURRENCY=500
NES_MAX_PORTS_PER_SCAN=8000
NES_MAX_HOSTS_PER_SCAN=512
NES_RATE_LIMIT_PER_SECOND=400

# --- authorisation guard ----------------------------------------------
# When false (the default), the scanner refuses any target outside private,
# loopback and link-local ranges. Set to true ONLY for infrastructure you own
# or have explicit written permission to test.
NES_ALLOW_PUBLIC_TARGETS=false

# --- vulnerability feeds ----------------------------------------------
NES_VULN_LOOKUPS_ENABLED=true
NES_VULN_CACHE_TTL_SECONDS=21600
# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD allows ~5 requests / 30s; with it, ~50.
NES_NVD_API_KEY=
